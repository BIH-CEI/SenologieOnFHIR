  "name": "Senologie_HER2_Status",
  "title": "BIH Senologie HER2-Status (IHC)",
  "status": "draft",
  "experimental": false,
  "date": "2026-10-09",
  "description": "HER2-Status aus Immunhistochemie — erbt MII Onko Mamma Her2neu Status (oBDS + Leitlinien-Slicing inkl. HER2-low/HER2-ultralow, IHC-Score + ISH-Ergebnis). Quantitative ISH-Details (Ratio/Kopienzahl) werden über MII MTB INSITUHYBRIDIZATION_HER2 abgebildet.",
  "fhirVersion": "4.0.1",
  "mapping": [
    {
      "identity": "lm",
      "name": "BIH LM Senologie",
      "uri": "https://www.senologie.org/fhir/StructureDefinition/LogicalModelSenologie",
      "comment": "Bezugselement im Logischen Modell: Pathologie.BefundInvasiv.Biomarker.HER2"
    }
  ],
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "https://www.medizininformatik-initiative.de/fhir/ext/modul-onko/StructureDefinition/mii-pr-onko-mamma-her2neu-status",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation.value[x].coding:DefinitionLeitlinie",
        "path": "Observation.value[x].coding",
        "sliceName": "DefinitionLeitlinie",
        "short": "Leitlinien-Klassifikation (positiv / HER2-low / HER2-ultralow / negativ / equivocal) — empfohlen für HER2-low-Analysen",
        "comment": "ER-low und HER2-low sind nur über den Leitlinien-Slice analysierbar (oBDS-Slice kennt nur positiv/negativ/unbekannt)."
      },
      {
        "id": "Observation.hasMember",
        "path": "Observation.hasMember",
        "short": "Verweis auf ISH-Reflextestung bei IHC 2+ (MII MTB INSITUHYBRIDIZATION_HER2)",
        "comment": "Bei equivocal IHC (2+) sollte hier auf das MII MTB ISH-HER2 Observation-Profil referenziert werden, das HER2/CEP17-Ratio, Signale und Zellzahl quantitativ erfasst.",
        "mustSupport": true
      }
    ]
  }
