# ============================================================
# Senologie-on-FHIR — Testumgebung Konfiguration
# ============================================================
# Kopieren: cp .env.example .env
# Anpassen: Aidbox-Lizenz + ggf. Terminologieserver-URL eintragen

# --- Aidbox (kostenlose Lizenz: https://aidbox.app/) ---
AIDBOX_LICENSE=your-license-jwt-here

# --- Terminologieserver fuer scripts/audit-valueset-codes.py ---
# Default ist lokales Snowstorm (Port 8090). Wenn du einen anderen Server
# nutzt (z.B. den BIH/MII-Terminologie-Proxy), hier den FHIR-Base setzen.
# Beispiele:
#   TERMINOLOGY_SERVER=http://localhost:8090/fhir            # lokales Snowstorm
#   TERMINOLOGY_SERVER=http://localhost:<proxy-port>/fhir    # eigener Proxy
#   TERMINOLOGY_SERVER=https://r4.ontoserver.csiro.au/fhir   # public Fallback
TERMINOLOGY_SERVER=http://localhost:8090/fhir

# --- dotbase Remote Aidbox (optional) ---
# Fuer scripts/sync-to-dotbase.sh — Resources gegen die hosted dotbase-Instance pushen.
# Cookie aus dem eingeloggten Browser-Tab kopieren:
#   DevTools → Application → Cookies → Domain senologie.instances.dotbase.org
#   Alle Cookies dieser Domain als "name=value; name2=value2; ..." zusammenfuegen.
DOTBASE_BASE_URL=https://senologie.instances.dotbase.org/api/aidbox/u/rest
# DOTBASE_COOKIE='aidbox-auth-session=...; session=...'
