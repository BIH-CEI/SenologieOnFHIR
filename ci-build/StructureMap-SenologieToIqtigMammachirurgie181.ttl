           fhir:rule ( [
             fhir:name [ fhir:v "MapKomplCondCode" ] ;
             fhir:source ( [
               fhir:context [ fhir:v "kcCond" ] ;
               fhir:element [ fhir:v "code" ] ;
               fhir:variable [ fhir:v "code" ]
             ] ) ;
             fhir:rule ( [
               fhir:name [ fhir:v "MapKomplICDCoding" ] ;
               fhir:source ( [
                 fhir:context [ fhir:v "code" ] ;
                 fhir:element [ fhir:v "coding" ] ;
                 fhir:variable [ fhir:v "c" ] ;
