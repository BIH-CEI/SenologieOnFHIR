{
  "resourceType": "ViewDefinition",
  "id": "senologie-bodystructure-flat",
  "name": "senologie_bodystructure_flat",
  "title": "Senologie BodyStructure Flat View",
  "description": "Tumor-Entitaeten als BodyStructures — der Senologie-Lifecycle-Anker. Eine Zeile pro BS mit Patient, Lokalisation (SCT + R5-Backport-Extension fuer Lateralitaet/Quadrant), Morphologie (nach Patho-Histo-Update), active-Flag.",
  "status": "active",
  "resource": "BodyStructure",
  "select": [
    {
      "column": [
        { "name": "bs_id", "path": "id" },
        { "name": "patient_id", "path": "patient.getReferenceKey(Patient)" },
        { "name": "active", "path": "active" },
        { "name": "tumor_entity_id", "path": "identifier.where(system='https://www.senologie.org/fhir/sid/tumor-entity').value.first()" },
        { "name": "location_sct", "path": "location.coding.where(system='http://snomed.info/sct').code.first()", "description": "Generische Body-Region (z.B. 76752008 Brust). Detail in den Sub-Spalten." },
        { "name": "laterality_sct", "path": "extension.where(url='http://hl7.org/fhir/5.0/StructureDefinition/extension-BodyStructure.includedStructure').extension.where(url='laterality').valueCodeableConcept.coding.code.first()", "description": "R5-Backport: Rechts/Links/Beidseits (SCT)." },
        { "name": "quadrant_sct", "path": "extension.where(url='http://hl7.org/fhir/5.0/StructureDefinition/extension-BodyStructure.includedStructure').extension.where(url='qualifier').valueCodeableConcept.coding.code.first()", "description": "R5-Backport: Quadrant (oben-aussen/innen/Mamille/etc., SCT)." },
        { "name": "morphology_sct", "path": "morphology.coding.where(system='http://snomed.info/sct').code.first()", "description": "Wird durch Patho-Form mit Histo-Code ueberschrieben." },
        { "name": "morphology_icdo3", "path": "morphology.coding.where(system='http://terminology.hl7.org/CodeSystem/icd-o-3').code.first()" },
        { "name": "description", "path": "description" }
      ]
    }
  ]
}
