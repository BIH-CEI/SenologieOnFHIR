<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" id="Storno">
	<xs:include schemaLocation="../Datentypen/IRD_DatenTypen.xsd"/>
	<xs:include schemaLocation="./MeldungIrdBasis.xsd"/>
	<xs:include schemaLocation="./StornoFallBasis.xsd"/>
	
	<xs:annotation>
		<xs:documentation>
			Dieses Schema beschreibt den Aufbau des Bausteins Storno, welcher aus Schemas "MeldungIrdBasis" und "StornoFallBasis" besteht.
		</xs:documentation>
	</xs:annotation>

	<xs:complexType name="Storno">
			<xs:complexContent>
				<xs:extension base="MeldungIrdBasis">
					<xs:sequence>
						<xs:element name="fall" type="StornoFallBasis"/>
					</xs:sequence>
				</xs:extension>
			</xs:complexContent>
	</xs:complexType>
</xs:schema>