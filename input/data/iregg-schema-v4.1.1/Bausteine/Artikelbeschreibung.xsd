<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" id="Artikelbeschreibung">
	<xs:include schemaLocation="./ArtikelbeschreibungBasis.xsd"/>
	<xs:include schemaLocation="./ArtikelBrustimplantatBasis.xsd"/>
	<xs:include schemaLocation="./ArtikelEndoprotheseBasis.xsd"/>
	<xs:include schemaLocation="./ArtikelAortenklappeBasis.xsd"/>
	<xs:annotation>
		<xs:documentation>
			Dieses Schema beschreibt den Aufbau des Bausteins Artikelbeschreibung, welcher aus den Schemas "ArtikelbeschreibungBasis", "ArtikelBrustimplantatBasis", "ArtikelEndoprotheseBasis"  und "ArtikelAortenklappeBasis" besteht.
		</xs:documentation>
	</xs:annotation>
	<xs:complexType name="Artikelbeschreibung">
		<xs:complexContent>
			<xs:extension base="ArtikelbeschreibungBasis">
				<xs:sequence>
					<xs:choice>
						<xs:element name="artikelBrustimplantat" type="ArtikelBrustimplantatBasis"/>
						<xs:element name="artikelEndoprothese" type="ArtikelEndoprotheseBasis"/>
						<xs:element name="artikelAortenklappe" type="ArtikelAortenklappeBasis"/>
					</xs:choice>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>