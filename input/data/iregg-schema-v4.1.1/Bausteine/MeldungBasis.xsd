<?xml version="1.0" encoding="UTF-8" standalone="yes"?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" id="MeldungBasis">	<xs:include schemaLocation="../Datentypen/IRD_DatenTypen.xsd"/>	<xs:annotation>		<xs:documentation>			Dieses Schema beschreibt die Elemente des Bausteins MeldungBasis. 			Es handelt sich um übergeordnete technisch-organisatorische Details der Meldung. 			Elemente:			- MEL_IrdIdGesundheitseinrichtung: IRD-eigenes eindeutiges Kennzeichen der Gesundheitseinrichtung			- MEL_StandortId: Standort-ID			- MEL_Bsnr: Betriebsstättennummer (BSNR)			- MEL_IrdSpezVersion: Version der IRD-Spezifikation			- MEL_SwName: Name der Software, mit der dieser Datensatz erstellt wurde			- MEL_SwHersteller: Name des Herstellers der Software, mit der dieser Datensatz erstellt wurde			- MEL_SwVersion: Version der Software, mit der dieser Datensatz erstellt wurde		</xs:documentation>	</xs:annotation>	<xs:complexType name="MeldungBasis">		<xs:sequence>			<xs:element name="MEL_IrdIdGesundheitseinrichtung" type="IdEinrichtung"/>			<xs:element name="MEL_StandortId" type="xs:token" minOccurs="0"/>			<xs:element name="MEL_Bsnr" type="xs:token" minOccurs="0"/>			<xs:element name="MEL_IrdSpezVersion" type="IrdSpezVersion"/>			<xs:element name="MEL_SwName" type="Sw"/>			<xs:element name="MEL_SwHersteller" type="Sw"/>			<xs:element name="MEL_SwVersion" type="Sw"/>		</xs:sequence>	</xs:complexType></xs:schema>