<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">
<xs:include schemaLocation="./IRD_Wertelisten.xsd"/>
	<xs:simpleType name="DatumText">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des freien Datumformats: JJJJ[-MM[-TT]]</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="(([0-9]{4})([-][0-9]{2})?([-][0-9]{2})?)"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Freitext250">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Freitextes von 250 Zeichen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:maxLength value="250"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Freitext500">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Freitextes von 500 Zeichen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:maxLength value="500"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="HashWert">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Hashwertes der Meldebestätigung</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:length value="64"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="HashString">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Hash-Strings der Meldebestätigung</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:maxLength value="512"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ICD">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des ICD Code</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="([a-zA-Z][0-9]{2}(\.[0-9]{1,2})?(:[RLB])?)"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IdEinrichtung">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der Gesundheitseinrichtung-ID</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="(IRD-GE-[0-9]{8})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IrdArtikelId">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der IrdNummer</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:maxLength value="16"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IrdSpezVersion">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der Version der IRD-Spezifikation</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="(([1-9]|[1-9][0-9])\.(\d|[1-9][0-9])\.(\d|[1-9][0-9]))"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Meldebestaetigung">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der Meldebestätigungslaenge von 10 Zeichen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:length value="10"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="OPS">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Prozedurenschluessels</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="([135689]\-([0-9]){2}([a-zA-Z0-9]){1}(\.([a-zA-Z0-9]{1,2}))*(:[RLB])?)"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="String2">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des kodierten Entlassungsgrundes</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="([0-9]{2})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="String7">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung eines Katalogkodes</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="([0-9]{7})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="String20">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung von: Artikel-, Ident-, Serien-, Lot-Nummer des Produkts</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Sw">
		<xs:annotation>
			<xs:documentation>Facette für Merkmale der externen Software</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:maxLength value="120"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Transfernummer">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der Transfernummer</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="([a-z0-9]{64})"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="JaLeer">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Unbekannt-Wertes (Bedeutung 1=true)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:pattern value="(1)"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Versionsnummer">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der Versionsnummer des gelieferten Datensatzes</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:maxLength value="10"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl1">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der 1-stelligen Ganzzahlenwerte</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="9"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl2">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der 2-stelligen Ganzzahlenwerte</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="99"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl3">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der 3-stelligen Ganzzahlenwerte</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl4">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der 4-stelligen Ganzzahlenwerte</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="9999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl5">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der 5-stelligen Ganzzahlenwerte</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger">
			<xs:minInclusive value="1"/>
			<xs:maxInclusive value="99999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl3mitNull">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der 3-stelligen Ganzzahlenwerte inklusive "0"</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl5mitNull">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung der 5-stelligen Ganzzahlenwerte inklusive "0"</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="99999"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl1_1">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Formats [N].[N]</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
		  <xs:totalDigits value="2"/>
		  <xs:fractionDigits value="1"/>
		  <xs:minInclusive value='0.1'/>
		  <xs:maxInclusive value='9.9'/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl2_1">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Formats [NN].[N]</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
		  <xs:totalDigits value="3"/>
		  <xs:fractionDigits value="1"/>
		  <xs:minInclusive value='0.1'/>
		  <xs:maxInclusive value='99.9'/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Zahl3_1">
		<xs:annotation>
			<xs:documentation>Facette zur Festlegung des Formats [NNN].[N]</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:decimal">
		  <xs:totalDigits value="4"/>
		  <xs:fractionDigits value="1"/>
		  <xs:minInclusive value='0.1'/>
		  <xs:maxInclusive value='999.9'/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>