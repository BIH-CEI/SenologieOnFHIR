	elementFormDefault="qualified" attributeFormDefault="unqualified">
<!--
=========================================================================================================
Dieses Schema ist Bestandteil der XML-Spezifikation für Datenübermittelung in der Externen Qualitätssicherung und wurde vom
Institut für Qualitätssicherung und Transparenz im Gesundheitswesen im Rahmen seiner Aufgaben als Institution nach § 137a SGB V erstellt.
Die Nutzungsbedingungen entnehmen Sie bitte dem Dokument unter:
https://iqtig.org/impressum/
=========================================================================================================
-->
	<!-- 
========================================================================================================= 
Schema für:
Datei-Art:		Administrative Datentypen
=========================================================================================================
-->
	<xs:import namespace="http://www.w3.org/2001/04/xmlenc#"
		schemaLocation="./imports/xenc-schema.xsd"/>
	<xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
		schemaLocation="./imports/xmldsig-core-schema.xsd"/>
	<xs:include schemaLocation="sqg_datatypes.xsd"/>
	<xs:complexType name="case_id_type">
		<xs:attribute name="V" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="38"/>
					<xs:minLength value="1"/>
					<!-- Prüfung 62: Ist der Wert (Attribut V) eines Pflichtfelds angegeben? -->
					<!-- anything but newline + something not whitespace + anything but newline -->
					<xs:pattern value=".*\S.*"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>	
	<xs:complexType name="date_type">
		<xs:attribute name="V" type="xs:dateTime" use="required"/>
	</xs:complexType>
	<xs:complexType name="date_woTime_type">
		<xs:attribute name="V" type="xs:date" use="required"/>
	</xs:complexType>
	<xs:complexType name="guid_type">
		<xs:attribute name="V" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern
						value="\{([0-9a-fA-F]){8}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){12}\}"
					/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:simpleType name="emailAddress_type">
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enum_crud_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="create"/>
			<xs:enumeration value="update"/>
			<xs:enumeration value="delete"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="validity_period_type">
		<xs:sequence>
			<xs:element name="start_date" type="date_woTime_type">
				<xs:annotation>
					<xs:documentation>Anfangsdatum</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="end_date" type="date_woTime_type">
				<xs:annotation>
					<xs:documentation>Enddatum</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="target_type">
		<xs:attribute name="V" type="enum_target_type" use="required"/>
	</xs:complexType>
	<xs:complexType name="crud_type">
		<xs:annotation>
			<xs:documentation>werte können create, update, delete sein und legen fest, wie im
				Datenfluss mit den Daten umgegangen werden müssen. Bei delete entfällt z.B. eine
				Plausibilitätsprüfung von QS-Daten. diese Daten würden im delete Fall gar nicht
				vorliegen.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="enum_crud_type" use="required"/>
	</xs:complexType>
	<xs:complexType name="module_type">
		<xs:attribute name="V" type="enum_exportmodul_type" use="required"/>
	</xs:complexType>
	<xs:complexType name="quarter_type">
		<xs:annotation>
			<xs:documentation>Für die Angabe von Quartalen auf Fallebene.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="quartdatum_type" use="required"/>
	</xs:complexType>	
	<xs:complexType name="flow_type">
		<xs:attribute name="V" type="enum_flow_type" use="required"/>
	</xs:complexType>
	<xs:complexType name="organisation_base_type">
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="email" type="emailAddress_type" use="optional"/>
		<xs:attribute name="fax" type="xs:string"/>
		<xs:attribute name="phone" type="xs:string"/>
		<xs:attribute name="address" type="xs:string"/>
		<xs:attribute name="function" type="enum_organisation_type" use="required">
			<xs:annotation>
				<xs:documentation>In diesem Attribut wird aus einer Enum ausgewählt, welche die
					Funktion im QS-Datenfluss beschreibt</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="registration" type="registration_type" use="optional">
			<xs:annotation>
				<xs:documentation>(1) Leistungserbringer -> DAS: Registriernummer des Dokumentationssystems (Länderkode + Registrierkode) vergeben durch die Datenannahmestelle (2) Leistungserbringer -> BAS: Registriernummer des Dokumentationssystems (BQ + Registrierkode) vergeben durch die Bundesauswertestelle</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="organisation_type">
		<xs:complexContent>
			<xs:restriction base="organisation_base_type">
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="email" type="emailAddress_type" use="optional"/>
		<xs:attribute name="fax" type="xs:string"/>
		<xs:attribute name="phone" type="xs:string"/>
		<xs:attribute name="address" type="xs:string"/>
		<xs:attribute name="function" type="enum_organisation_type" use="required">
			<xs:annotation>
				<xs:documentation>In diesem Attribut wird aus einer Enum ausgewählt, welche die
					Funktion im QS-Datenfluss beschreibt</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="registration" type="registration_type" use="required">
			<xs:annotation>
				<xs:documentation>(1) Leistungserbringer -> DAS: Registriernummer des Dokumentationssystems (Länderkode + Registrierkode) vergeben durch die Datenannahmestelle (2) Leistungserbringer -> BAS: Registriernummer des Dokumentationssystems (BQ + Registrierkode) vergeben durch die Bundesauswertestelle</xs:documentation>
			</xs:annotation>
		</xs:attribute>
				</xs:restriction>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="organisation_without_cp_type">
		<xs:complexContent>
			<xs:restriction base="organisation_base_type">
				<xs:attribute name="name" type="xs:string" use="required"/>
				<xs:attribute name="email" type="emailAddress_type" use="optional"/>
				<xs:attribute name="fax" type="xs:string"/>
				<xs:attribute name="phone" type="xs:string"/>
				<xs:attribute name="address" type="xs:string"/>
				<xs:attribute name="function" type="enum_validation_provider_type" use="required">
					<xs:annotation>
						<xs:documentation>In diesem Attribut wird aus einer Enum ausgewählt, welche
							die Funktion im QS-Datenfluss beschreibt</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="registration" type="registration_type" use="optional">
					<xs:annotation>
						<xs:documentation>nur Dem Attribut registration kann die vom IQTIG ehemals vergebene Registriernummer für die eingesetzte QS-Software zugewiesen werden. (Hinweis: registration hier ist nicht identisch mit dem QSDOK.Zusatzfeld 'RegistrierNr' (provider/@registration)).</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:restriction>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="organisation_without_cp_doku_vali_provider_type">
		<xs:complexContent>
			<xs:restriction base="organisation_without_cp_type">
				<xs:attribute name="name" type="xs:string" use="required"/>
				<xs:attribute name="email" type="emailAddress_type" use="optional"/>
				<xs:attribute name="fax" type="xs:string"/>
				<xs:attribute name="phone" type="xs:string"/>
				<xs:attribute name="address" type="xs:string"/>
				<xs:attribute name="function" type="enum_validation_provider_type" use="required">
					<xs:annotation>
						<xs:documentation>In diesem Attribut wird aus einer Enum ausgewählt, welche
							die Funktion im QS-Datenfluss beschreibt</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="registration" type="registration_type" use="required">
					<xs:annotation>
						<xs:documentation>Wenn '@function' dem Wert 'Softwareanbieter' entspricht, dann sind hier mögliche Werte: (1) die vom IQTIG ehemals vergebene Registriernummer für die eingesetzte QS-Software/Softwareanbieter (2) KBV-Prüfnummer der eingesetzten Software oder der Dummy-Wert '000'</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:restriction>
		</xs:complexContent>
	</xs:complexType>
		<xs:complexType name="organisation_type_kv">
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="email" type="emailAddress_type" use="optional"/>
		<xs:attribute name="fax" type="xs:string"/>
		<xs:attribute name="phone" type="xs:string"/>
		<xs:attribute name="address" type="xs:string"/>
		<xs:attribute name="function" type="enum_organisation_type" use="required">
			<xs:annotation>
				<xs:documentation>In diesem Attribut wird aus einer Enum ausgewählt, welche die
					Funktion im QS-Datenfluss beschreibt</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="registration" type="registration_type" use="optional">
			<xs:annotation>
				<xs:documentation>Registriernummer. Sollte für die Datenübertragung (an die
					KV) keine Registriernummer erforderlich sein, ist hier keine Angabe erforderlich.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:simpleType name="enum_organisation_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Bundesauswertestelle"/>
			<xs:enumeration value="Datenannahmestelle"/>
			<xs:enumeration value="Vertrauensstelle"/>
			<xs:enumeration value="Leistungserbringer"/>
			<xs:enumeration value="Softwarehersteller"/>
			<xs:enumeration value="Versendestelle"/>
			<xs:enumeration value="undefined"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enum_validation_provider_type">
		<xs:restriction base="enum_organisation_type">
			<xs:enumeration value="Bundesauswertestelle"/>
			<xs:enumeration value="Datenannahmestelle"/>
			<xs:enumeration value="Vertrauensstelle"/>
			<xs:enumeration value="Softwarehersteller"/>
			<xs:enumeration value="Versendestelle"/>
			<xs:enumeration value="undefined"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="information_system_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Name der eingesetztenSoftware</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="vendor" type="vendor_type">
				<xs:annotation>
					<xs:documentation>Name des KIS- bzw. AIS-Herstellers</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="name" type="softwareName_type">
				<xs:annotation>
					<xs:documentation>Name des KIS bzw. des AIS </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="vendor_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Version der eingesetzten Software</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:complexType name="softwareName_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Name der eingesetztenSoftware</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:complexType name="softwareVersion_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Release der eingesetzten Software</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:minLength value="1"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="softwareRelease_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Release der eingesetzten Software</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:complexType name="specificationVersion_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Version der Spezifikation</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:complexType name="specificationRelease_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Release-Version der Spezifikation</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="xs:string" use="required"/>
	</xs:complexType>
	<xs:complexType name="specification_type">
		<xs:annotation>
			<xs:documentation xml:lang="de">Infos über die Spezifikation</xs:documentation>
		</xs:annotation>
		<xs:attribute name="V" type="enum_spez_type" use="required"/>
	</xs:complexType>
	<xs:simpleType name="enum_flow_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="QS-Bundesbezogen"/>
			<xs:enumeration value="QS-Laenderbezogen"/>
			<xs:enumeration value="QS-Kollektivvertraglich"/>
			<xs:enumeration value="QS-Selektivvertraglich"/>
			<xs:enumeration value="Strukturierter Dialog"/>
			<xs:enumeration value="Datenvalidierung"/>
			<xs:enumeration value="Protokoll"/>
			<xs:enumeration value="Sollstatistik"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="soll_statistic_type">
		<xs:sequence>
			<xs:element name="expected" type="soll_statistic_data_type">
				<xs:annotation>
					<xs:documentation>erwartete Fälle</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="soll_statistic_s_type">
		<xs:sequence>
			<xs:element name="expected" type="soll_statistic_data_s_type" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>erwartete Fälle</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="soll_statistic_data_s_type">
		<xs:attribute name="date_from" type="xs:date" use="required">
			<xs:annotation>
				<xs:documentation>Beginn Erfassungszeitraum</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="date_to" type="xs:date" use="required">
			<xs:annotation>
				<xs:documentation>Ende Erfassungszeitraum</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="count" type="xs:nonNegativeInteger" use="required">
			<xs:annotation>
				<xs:documentation>Anzahl der aufgetretenen Auslösungen im jeweiligen Modul im
					Zeitraum </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="date_admission_from" type="xs:date" use="optional">
			<xs:annotation>
				<xs:documentation>Beginn Aufnahmezeitraum</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="date_admission_to" type="xs:date" use="optional">
			<xs:annotation>
				<xs:documentation>Ende Aufnahmezeitraum</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="relation" type="enum_relation_soll_type" use="optional">
			<xs:annotation>
				<xs:documentation>Bezugsbereich der Zählungen</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="region" type="enum_region_type" use="optional">
			<xs:annotation>
				<xs:documentation>Schlüsselcode der gültigen Region</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="submodule" type="enum_submodule_type" use="optional">
			<xs:annotation>
				<xs:documentation>Name des inneren Moduls (Zielleistungsbereich) </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="count_drg" type="xs:nonNegativeInteger" use="optional">
			<xs:annotation>
				<xs:documentation>Anzahl der aufgetretenen DRG-Auslösungen im jeweiligen Modul im
					Zeitraum </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="count_iv" type="xs:nonNegativeInteger" use="optional">
			<xs:annotation>
				<xs:documentation>Anzahl der aufgetretenen IV-Auslösungen im jeweiligen Modul im
					Zeitraum </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="count_dmp" type="xs:nonNegativeInteger" use="optional">
			<xs:annotation>
				<xs:documentation>Anzahl der aufgetretenen DMP-Auslösungen im jeweiligen Modul im
					Zeitraum </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="count_other" type="xs:nonNegativeInteger" use="optional">
			<xs:annotation>
				<xs:documentation>Anzahl der aufgetretenen anderen Auslösungen im jeweiligen Modul
					im Zeitraum </xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

