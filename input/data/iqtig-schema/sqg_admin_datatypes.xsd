	<xs:complexType name="soll_statistic_data_type">
		<xs:attribute name="date_from" type="xs:date" use="required">
			<xs:annotation>
				<xs:documentation>Gültigkeitszeitraum der Sollstatistik (Anfang) </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="date_to" type="xs:date" use="required">
