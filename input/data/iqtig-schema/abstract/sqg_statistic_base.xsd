<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">

	<xs:complexType name="statistic_base_type">
		<xs:sequence>
			<xs:element name="sent" type="statistic_data_type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>geschickte Vorgänge</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="processed" type="statistic_data_type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>verarbeitete Vorgänge</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
