            <xs:element name="ltSauerEnde">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Lebenstage des Kindes bei Ende der Sauerstoffgabe (in Tagen)</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="BEATMUNG">
              <xs:annotation>
                <xs:documentation>BogenFeld: Beatmung (von mehr als 30 Minuten) durchgeführt</xs:documentation>
