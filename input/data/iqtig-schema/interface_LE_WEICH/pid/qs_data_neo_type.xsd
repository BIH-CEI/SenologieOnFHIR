                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="AUFNTEMP">
              <xs:annotation>
                <xs:documentation>BogenFeld: Körpertemperatur bei Aufnahme</xs:documentation>
