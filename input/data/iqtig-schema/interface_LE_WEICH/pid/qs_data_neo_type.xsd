                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="ltAufPaed">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Lebenstage des Kindes bei Aufnahme in die pädiatrische Abteilung</xs:documentation>
              </xs:annotation>
