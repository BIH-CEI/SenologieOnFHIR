              <xs:complexType>
                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="BEATBEGINN">
              <xs:annotation>
                <xs:documentation>BogenFeld: Beginn</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="ltBeatBeginn">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Lebenstage des Kindes bei Beginn der Beatmung (in Tagen)</xs:documentation>
