                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="BEATENDECPAP">
              <xs:annotation>
                <xs:documentation>BogenFeld: endgültige Beendigung jeglicher Atemhilfe</xs:documentation>
