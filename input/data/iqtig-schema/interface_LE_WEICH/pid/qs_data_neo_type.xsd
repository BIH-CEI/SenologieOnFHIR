                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="BEATENDE">
              <xs:annotation>
                <xs:documentation>BogenFeld: endgültige Beendigung der intratrachealen Beatmung</xs:documentation>
