            </xs:element>
            <xs:element name="SAUERENDE">
              <xs:annotation>
                <xs:documentation>BogenFeld: endgültige Beendigung</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
