            <xs:element name="abstAufnahmePaed">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Abstand zwischen Aufnahmezeitpunkt und Aufnahme in die pädiatrische Abteilung (in Minuten)</xs:documentation>
