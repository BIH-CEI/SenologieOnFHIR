                <xs:attribute name="V" type="xs:anySimpleType" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="AUSLIKNRKH">
              <xs:annotation>
                <xs:documentation>BogenFeld: Aufnahme aus ausländischem Krankenhaus</xs:documentation>
