                <xs:attribute name="V" type="enum_jleer_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="ENTLKOMPLEXBEHAND">
              <xs:annotation>
                <xs:documentation>BogenFeld: Entlassung in die geriatrische frührehabilitative Komplexbehandlung;
gemäß § 109 SGB V</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jn_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="KOMPLEXBEHANDLUNG">
              <xs:annotation>
                <xs:documentation>BogenFeld: geriatrische frührehabilitative Komplexbehandlung intern durchgeführt;
gemäß OPS 8-550.-</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jleer_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element maxOccurs="100" name="ENTLDIAG">
              <xs:annotation>
                <xs:documentation>BogenFeld: Entlassungsdiagnose(n);
ICD-10-GM</xs:documentation>
              </xs:annotation>
