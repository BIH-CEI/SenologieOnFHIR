                <xs:attribute name="V" type="icd10_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="APOPLEXZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: Schlaganfall</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="GELENKINFEKTZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: Infektion am Gelenk</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="KARDVASKKOMPZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: behandlungsbedürftige kardiale Komplikation(en)</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="LUNGEMBOLIEZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: Lungenembolie</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="MECHANKOMPLZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: mechanische Komplikation</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="NIERENINSUFFIZIENZZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: akute Niereninsuffizienz</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="PNEUMONIEZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: Pneumonie;
nach den KISS-Definitionen</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="THROMBOSENZP">
              <xs:annotation>
                <xs:documentation>BogenFeld: Bein-/Beckenvenenthrombose</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplzeitpunkt_type" use="optional"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
