<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" attributeFormDefault="unqualified" elementFormDefault="qualified">
  <!--
=========================================================================================================
Dieses Schema ist Bestandteil der XML-Spezifikation für Datenübermittelung in der Externen Qualitätssicherung und wurde vom 
Institut für Qualitätssicherung und Transparenz im Gesundheitswesen im Rahmen seiner Aufgaben als Institution nach § 137a SGB V erstellt.
Die Nutzungsbedingungen entnehmen Sie bitte dem Dokument unter:
https://iqtig.org/impressum/
=========================================================================================================
-->
  <xs:include schemaLocation="../../sqg_datatypes.xsd"/>
  <xs:include schemaLocation="../../abstract/sqg_qs_data_base.xsd"/>
  <xs:complexType name="qs_data_pntxfu_type">
    <xs:complexContent>
      <xs:extension base="qs_data_type">
        <xs:sequence>
          <xs:element name="B" type="tds_bpntxfu_type">
            <xs:annotation>
              <xs:documentation>Bogen: Basis // Bogenzahl: 1 </xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="module" use="required">
          <xs:annotation>
            <xs:documentation>Nieren- und Pankreas- (Nieren-) transplantation Follow-up</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="enum_exportmodul_type">
              <xs:enumeration value="PNTXFU_DeQS"/>

            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="tds_bpntxfu_type">
    <xs:sequence>
      <xs:element name="felder">
        <xs:annotation>
          <xs:documentation>Exportfelder des Bogens</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="DokAbschlDat">
              <xs:annotation>
                <xs:documentation>ZusatzFeld: Dokumentationsabschlussdatum</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="datum_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="kasseiknr2Stellen">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Ersatzfeld Institutionskennzeichen der Krankenkasse der Versichertenkarte</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:pattern value="[0-9]{2}"/>
                      <xs:maxLength value="2"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="versichertenstatusgkv">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: GKV-Versichertenstatus</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:int">
                      <xs:totalDigits value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="VERSICHERTENIDNEUNV">
              <xs:annotation>
                <xs:documentation>BogenFeld: Der Patient verfügt über keine eGK-Versichertennummer</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jleer_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="EINWBAS">
              <xs:annotation>
                <xs:documentation>BogenFeld: Liegt eine wirksame Einwilligung des Patienten zur weiteren Verarbeitung personenbezogener QS-Daten (einschließlich ET-Nummer) in der Bundesauswertungsstelle vor?</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jn_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="FACHABT">
              <xs:annotation>
                <xs:documentation>BogenFeld: Fachabteilung</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="fachabt_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="EINWTXREG">
              <xs:annotation>
                <xs:documentation>BogenFeld: Liegt eine wirksame Einwilligung des Patienten zur weiteren Übermittlung personenbezogener QS-Daten (einschließlich ET-Nummer) an das Transplantationsregister vor?</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jn_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="EINWTXREGAUFK">
              <xs:annotation>
                <xs:documentation>BogenFeld: Wurde der Patient im Rahmen eines ärztlichen Aufklärungsgesprächs über die Einwilligung und die Folgen eines möglichen Widerrufs der Einwilligung zur Übermittlung der personenbezogenen Daten an das Transplantationsregister aufgeklärt?</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jnu_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="gebjahr">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Geburtsjahr</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="xs:gYear" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="GESCHLECHT">
              <xs:annotation>
                <xs:documentation>BogenFeld: Geschlecht</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_geschlecht_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="KOMBTRANSNIERE">
              <xs:annotation>
                <xs:documentation>BogenFeld: durchgeführte Transplantation</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_transnierepankreas_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="TXDATUM">
              <xs:annotation>
                <xs:documentation>BogenFeld: Datum der letzten Transplantation</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="datum_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="FUERHEBDATUM">
              <xs:annotation>
                <xs:documentation>BogenFeld: Datum der Follow-up-Erhebung</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="datum_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="abstFUErhebungsdatumTxDatum">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Abstand Erhebungsdatum des Follow-up und Datum der letzten Transplantation in Tagen</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="required">
                  <xs:simpleType>
                    <xs:restriction base="xs:int">
                      <xs:totalDigits value="7"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="monatFUErhebung">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Monat des Follow-up Erhebungsdatum</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="mondatum_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="FUZEITP">
              <xs:annotation>
                <xs:documentation>BogenFeld: Follow-up-Zeitpunkt nach Transplantation</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_fuzeitp_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="ARTFUSPEN">
              <xs:annotation>
                <xs:documentation>BogenFeld: Art der Follow-up-Erhebung</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_artfuspen_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="FUVERSTORBEN">
              <xs:annotation>
                <xs:documentation>BogenFeld: Patient verstorben</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jnufup_type" use="required"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="TODESDATUM">
              <xs:annotation>
                <xs:documentation>BogenFeld: Todesdatum</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="datum_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="abstTodTxDatum">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Abstand zwischen Todesdatum und Datum der letzten Transplantation</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:int">
                      <xs:totalDigits value="7"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="monatTod">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Monat des Todesdatums</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="mondatum_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="EDTATOD">
              <xs:annotation>
                <xs:documentation>BogenFeld: Todesursache</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_todesursachentx_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="KOMPLFU">
              <xs:annotation>
                <xs:documentation>BogenFeld: Komplikation</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_komplfu_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="CLAVIENDINDONB">
              <xs:annotation>
                <xs:documentation>BogenFeld: unbekannt, ob Komplikation vorliegt</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jleer_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="TRANSPLANTATVERS">
              <xs:annotation>
                <xs:documentation>BogenFeld: Transplantatversagen Niere</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jnu_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="TRANSPLANTATVERSDATUM">
              <xs:annotation>
                <xs:documentation>BogenFeld: Datum Transplantatversagen Niere</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="datum_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="abstTransplantatVersDatum">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Abstand zwischen Datum des Transplantatversagens und Datum der letzten Transplanatation in Tagen</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:int">
                      <xs:totalDigits value="7"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="monatTransplantatVers">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Monat des Transplantatversagens</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="mondatum_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="TRANSPLANTATVERSURS">
              <xs:annotation>
                <xs:documentation>BogenFeld: Ursache Transplantatversagen Niere</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_transplantatversurs_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="KREATININWERTMGDL">
              <xs:annotation>
                <xs:documentation>BogenFeld: Kreatininwert i.S. in mg/dl;
Follow-up</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minInclusive value="0.1"/>
                      <xs:maxInclusive value="99.9"/>
                      <xs:totalDigits value="3"/>
                      <xs:fractionDigits value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="KREATININWERTMOLL">
              <xs:annotation>
                <xs:documentation>BogenFeld: Kreatininwert i.S. in µmol/l;
Follow-up</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:int">
                      <xs:minInclusive value="0"/>
                      <xs:totalDigits value="4"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="KREATININWERTNB">
              <xs:annotation>
                <xs:documentation>BogenFeld: Kreatininwert i.S. unbekannt;
Follow-up</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jleer_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="REJEKTIONFU">
              <xs:annotation>
                <xs:documentation>BogenFeld: behandlungsbedürftige Abstoßung der Niere seit Entlassung</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jnu_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="REJEKTBIOPS">
              <xs:annotation>
                <xs:documentation>BogenFeld: Abstoßung der Niere durch Biopsie gesichert</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jn_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="TRANSPLANTATVERSPANKREAS">
              <xs:annotation>
                <xs:documentation>BogenFeld: Patient bei Follow-up-Untersuchung insulinfrei?</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="enum_jnu_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="TRANSPLANTATVERSDATUMPANK">
              <xs:annotation>
                <xs:documentation>BogenFeld: Beginn der Insulintherapie</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="datum_type" use="optional"/>
              </xs:complexType>
            </xs:element>
            <xs:element name="abstTransplantatVersDatumPank">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Abstand zwischen Beginn der Insulinpflicht nach Transplantatversagen und Datum der letzten Transplanatation in Tagen</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" use="optional">
                  <xs:simpleType>
                    <xs:restriction base="xs:int">
                      <xs:totalDigits value="7"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
            <xs:element name="monatTransplantatVersPank">
              <xs:annotation>
                <xs:documentation>ErsatzFeld: Monat des Beginns der Insulinpflicht nach Transplantatversagen</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:attribute name="V" type="mondatum_type" use="optional"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
